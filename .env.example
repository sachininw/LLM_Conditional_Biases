# Copy this file to .env and fill in your API keys.
# Required keys depend on which models you run — see README for the full table.

# OpenAI — GPT-4o (evaluation + test generation)
OPENAI_API_KEY=

# Anthropic — Claude-3.5-Haiku
ANTHROPIC_API_KEY=

# Google — Gemini-1.5-Pro, Gemini-2.5-Flash, Gemma-2-9B-IT (via DeepInfra, see below)
GOOGLE_API=

# DeepInfra — Llama-3.1-8B/70B, Qwen-2.5-72B, DeepSeek-V3, Phi-4, Gemma-2-9B-IT
DEEPINFRA_API=
