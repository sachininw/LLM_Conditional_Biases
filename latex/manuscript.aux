\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Causal identification summary across all 8 LLMs and 9 target biases. Each row is a target bias; each colored dot is one model. \textbf  {Left}: DiD ATT with 95\% CI error bars; positive = amplification, negative = suppression. \textbf  {Right}: SCM gap (on-diagonal minus synthetic counterfactual); filled diamonds ($\blacklozenge $) indicate placebo $p{<}0.05$. Planning Fallacy is the only bias with consistently positive ATT and significant SCM gaps across models. Per-model plots in Appendix\nobreakspace  {}\ref  {app:per_model}.\relax }}{8}{figure.caption.15}\protected@file@percent }
\newlabel{fig:causal_forest}{{3}{8}{Causal identification summary across all 8 LLMs and 9 target biases. Each row is a target bias; each colored dot is one model. \textbf {Left}: DiD ATT with 95\% CI error bars; positive = amplification, negative = suppression. \textbf {Right}: SCM gap (on-diagonal minus synthetic counterfactual); filled diamonds ($\blacklozenge $) indicate placebo $p{<}0.05$. Planning Fallacy is the only bias with consistently positive ATT and significant SCM gaps across models. Per-model plots in Appendix~\ref {app:per_model}.\relax }{figure.caption.15}{}}
\newlabel{fig:causal_forest@cref}{{[figure][3][]3}{[1][7][]8}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Model effect space: $\bar  {\Delta }_n$ (y) vs.\ $\bar  {\delta }$ (x) for all 8 LLMs. Bubble area $\propto $ MMLU; color = alignment recipe. Suppression-dominant models (6) occupy the left half; deliberative models the right. Claude-3.5-Haiku is the only model with negative $\bar  {\Delta }_n$ ($-0.101$).\relax }}{8}{figure.caption.16}\protected@file@percent }
\newlabel{fig:effect_space}{{4}{8}{Model effect space: $\bar {\Delta }_n$ (y) vs.\ $\bar {\delta }$ (x) for all 8 LLMs. Bubble area $\propto $ MMLU; color = alignment recipe. Suppression-dominant models (6) occupy the left half; deliberative models the right. Claude-3.5-Haiku is the only model with negative $\bar {\Delta }_n$ ($-0.101$).\relax }{figure.caption.16}{}}
\newlabel{fig:effect_space@cref}{{[figure][4][]4}{[1][7][]8}}
