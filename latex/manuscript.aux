\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Llama-3.1-8B DiD ATT per target bias. Planning Fallacy is the only statistically significant positive coefficient; all others are near-zero or negative.\relax }}{18}{figure.caption.40}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Llama-3.1-8B SCM gap. Treated unit gap (solid) vs.\ placebo donor gaps (grey). Planning Fallacy, Loss Aversion, and Status Quo Bias exceed the placebo distribution, confirming causal inducibility.\relax }}{18}{figure.caption.41}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Llama-3.1-70B DiD ATT. Planning Fallacy is the only significant positive ATT; the scale-up from 8B slightly strengthens suppression for most other biases.\relax }}{18}{figure.caption.42}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Llama-3.1-70B SCM gap. Planning Fallacy gap exceeds the placebo distribution; Loss Aversion and Status Quo Bias also show positive gaps, replicating the 8B inducible cluster.\relax }}{19}{figure.caption.43}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Claude-3.5-Haiku DiD ATT. Planning Fallacy shows a significant positive ATT; several other biases show mildly positive or near-zero coefficients, consistent with the amplification regime.\relax }}{19}{figure.caption.44}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Claude-3.5-Haiku SCM gap. Planning Fallacy gap exceeds placebo; the overall gap profile is positive-skewed compared to suppression-dominant models.\relax }}{19}{figure.caption.45}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces GPT-4o DiD ATT. Planning Fallacy is the only significant positive ATT at $p{<}0.05$; all other biases are suppressed or near-zero.\relax }}{20}{figure.caption.46}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces GPT-4o SCM gap. Planning Fallacy exceeds the placebo distribution; other biases are within the placebo envelope, consistent with the near-zero global total effect.\relax }}{20}{figure.caption.47}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces DeepSeek-V3 DiD ATT. Planning Fallacy shows the strongest positive ATT; unlike suppression-dominant models, several other biases also show near-zero or positive coefficients.\relax }}{20}{figure.caption.48}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces DeepSeek-V3 SCM gap. Planning Fallacy, Loss Aversion, and Status Quo Bias all exceed the placebo distribution, among the largest SCM gaps observed across all 8 models.\relax }}{21}{figure.caption.49}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces Qwen-2.5-72B DiD ATT. Planning Fallacy shows a positive ATT; other biases cluster near zero, consistent with a weak content signal and near-zero mean $\bar  {\delta }$.\relax }}{21}{figure.caption.50}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces Qwen-2.5-72B SCM gap. Planning Fallacy exceeds the placebo distribution; the coupling structure mirrors Western-trained models of comparable scale despite a Mandarin-dominant pre-training corpus.\relax }}{21}{figure.caption.51}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {19}{\ignorespaces Phi-4 DiD ATT. Planning Fallacy is the only significant positive ATT; all other biases show suppression, consistent with the model's reasoning-focused training.\relax }}{22}{figure.caption.52}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {20}{\ignorespaces Phi-4 SCM gap. Planning Fallacy gap exceeds the placebo distribution; other biases remain within the placebo envelope, confirming selective inducibility.\relax }}{22}{figure.caption.53}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {21}{\ignorespaces Gemma-2-9B-IT DiD ATT. Planning Fallacy is the only significant positive ATT, confirming that the inducible-bias finding is not capacity-dependent.\relax }}{22}{figure.caption.54}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {22}{\ignorespaces Gemma-2-9B-IT SCM gap. Planning Fallacy and Status Quo Bias exceed the placebo distribution; Availability Heuristic and Bandwagon Effect show the most negative gaps, consistent with their suppressible character across all models.\relax }}{23}{figure.caption.55}\protected@file@percent }
