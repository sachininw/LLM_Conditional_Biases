\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Mean absolute bias magnitudes and effect estimates. $\bar  {\Delta }_n$ = presence; $\bar  {\delta }$ = content; $\bar  {\Delta }_b$ = total. ${}^{**}p{<}0.01$, ${}^{***}p{<}0.001$ (one-sample $t$-test vs.\ 0). Claude-3.5-Haiku is the only model with a negative presence effect, consistent with Constitutional AI suppressing bias in dialogue mode.\relax }}{6}{table.caption.7}\protected@file@percent }
\newlabel{tab:means}{{1}{6}{Mean absolute bias magnitudes and effect estimates. $\bar {\Delta }_n$ = presence; $\bar {\delta }$ = content; $\bar {\Delta }_b$ = total. ${}^{**}p{<}0.01$, ${}^{***}p{<}0.001$ (one-sample $t$-test vs.\ 0). Claude-3.5-Haiku is the only model with a negative presence effect, consistent with Constitutional AI suppressing bias in dialogue mode.\relax }{table.caption.7}{}}
\newlabel{tab:means@cref}{{[table][1][]1}{[1][5][]6}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Total-effect ($\Delta _b = |m_b| - |m_\varnothing |$) heatmaps for all 8 evaluated LLMs. Each panel is a $9{\times }9$ matrix (rows = target LLM bias $\beta $; columns = human-turn bias $\gamma $); color encodes mean $\Delta _b$ (red = amplification over zero-shot, blue = suppression). Shared diverging color scale $[-0.3, +0.3]$; $\bar  {\Delta }_b$ and significance reported per panel. Planning Fallacy (row 8) is the only target bias with a consistently positive total effect across all models; most other rows are positive but attenuated, reflecting the partial cancellation of presence inflation by content suppression.\relax }}{6}{figure.caption.8}\protected@file@percent }
\newlabel{fig:total_grid}{{2}{6}{Total-effect ($\Delta _b = |m_b| - |m_\varnothing |$) heatmaps for all 8 evaluated LLMs. Each panel is a $9{\times }9$ matrix (rows = target LLM bias $\beta $; columns = human-turn bias $\gamma $); color encodes mean $\Delta _b$ (red = amplification over zero-shot, blue = suppression). Shared diverging color scale $[-0.3, +0.3]$; $\bar {\Delta }_b$ and significance reported per panel. Planning Fallacy (row 8) is the only target bias with a consistently positive total effect across all models; most other rows are positive but attenuated, reflecting the partial cancellation of presence inflation by content suppression.\relax }{figure.caption.8}{}}
\newlabel{fig:total_grid@cref}{{[figure][2][]2}{[1][5][]6}}
